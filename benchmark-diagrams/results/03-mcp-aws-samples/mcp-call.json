{
 "name": "generate_html_diagram",
 "arguments": {
  "title": "Version inventory — example",
  "subtitle": "Read-only observation over the existing delivery",
  "outputPath": "./inventory-aws.html",
  "groups": [
   {
    "id": "conta",
    "label": "Conta AWS central — região a definir",
    "variant": "aws-cloud"
   },
   {
    "id": "vpc",
    "label": "VPC privada — 2 AZ",
    "variant": "vpc",
    "parent": "conta"
   },
   {
    "id": "sub-app",
    "label": "Private subnets — application",
    "variant": "private-subnet",
    "parent": "vpc"
   },
   {
    "id": "sub-dados",
    "label": "Private subnets — data",
    "variant": "private-subnet",
    "parent": "vpc"
   },
   {
    "id": "pais",
    "label": "Environment network — Staging, Homologation, Production",
    "variant": "on-premises"
   }
  ],
  "services": [
   {
    "id": "user",
    "service": "Users",
    "label": "Corporate user",
    "role": "CISO, AppSec e DevSecOps",
    "external": true,
    "shape": "generic",
    "category": "general"
   },
   {
    "id": "alb",
    "service": "Application Load Balancer",
    "label": "Internal ALB",
    "role": "HTTPS entry with no public internet",
    "parentId": "sub-app",
    "category": "networking",
    "shape": "elastic_load_balancing"
   },
   {
    "id": "portal",
    "service": "Amazon Elastic Container Service",
    "label": "Web portal + API",
    "role": "Inventory, coverage and export with SSO and per-scope RBAC",
    "parentId": "sub-app",
    "category": "compute",
    "shape": "ecs"
   },
   {
    "id": "worker",
    "service": "Amazon Elastic Container Service",
    "label": "Collector worker",
    "role": "Queries ArgoCD read-only, sanitizes and normalizes",
    "parentId": "sub-app",
    "category": "compute",
    "shape": "ecs"
   },
   {
    "id": "sched",
    "service": "Amazon EventBridge",
    "label": "Scheduler",
    "role": "Triggers a cycle every 15 minutes",
    "parentId": "sub-app",
    "category": "integration",
    "shape": "eventbridge"
   },
   {
    "id": "fila",
    "service": "Amazon Simple Queue Service",
    "label": "Queue + DLQ",
    "role": "Retry, per-instance isolation, visible failures",
    "parentId": "sub-app",
    "category": "integration",
    "shape": "sqs"
   },
   {
    "id": "rds",
    "service": "Amazon RDS",
    "label": "PostgreSQL",
    "role": "Current state, catalog and history",
    "parentId": "sub-dados",
    "category": "database",
    "shape": "rds"
   },
   {
    "id": "s3",
    "service": "Amazon Simple Storage Service",
    "label": "Evidence",
    "role": "Sanitized snapshots with hash",
    "parentId": "sub-dados",
    "category": "storage",
    "shape": "s3"
   },
   {
    "id": "cofre",
    "service": "AWS Secrets Manager",
    "label": "Secrets vault",
    "role": "Read-only token per ArgoCD instance",
    "parentId": "sub-dados",
    "category": "security",
    "shape": "secrets_manager"
   },
   {
    "id": "nat",
    "service": "NAT Gateway",
    "label": "Controlled egress",
    "role": "Egress limited to authorized sources",
    "parentId": "vpc",
    "category": "networking",
    "shape": "nat_gateway"
   },
   {
    "id": "dx",
    "service": "AWS Direct Connect",
    "label": "Rota entre redes",
    "role": "Direct Connect ou VPN, proxy, DNS e CA",
    "pill": "to confirm",
    "pillOverlay": true,
    "parentId": "conta",
    "category": "networking",
    "shape": "direct_connect"
   },
   {
    "id": "argo",
    "service": "ArgoCD",
    "label": "ArgoCD API",
    "role": "Applications, resource tree and Pods",
    "parentId": "pais",
    "external": true,
    "category": "management",
    "shape": "generic"
   },
   {
    "id": "k8s",
    "service": "Kubernetes",
    "label": "Kubernetes clusters",
    "role": "Workloads e imagem observada nos Pods",
    "parentId": "pais",
    "external": true,
    "category": "compute",
    "shape": "eks"
   }
  ],
  "connections": [
   {
    "id": "c1",
    "source": "user",
    "target": "alb",
    "label": "internal HTTPS",
    "type": "network"
   },
   {
    "id": "c2",
    "source": "alb",
    "target": "portal"
   },
   {
    "id": "c3",
    "source": "portal",
    "target": "rds",
    "type": "data"
   },
   {
    "id": "c4",
    "source": "portal",
    "target": "s3",
    "type": "data"
   },
   {
    "id": "c5",
    "source": "sched",
    "target": "fila",
    "type": "event"
   },
   {
    "id": "c6",
    "source": "fila",
    "target": "worker",
    "type": "event"
   },
   {
    "id": "c7",
    "source": "worker",
    "target": "cofre",
    "type": "iam"
   },
   {
    "id": "c8",
    "source": "worker",
    "target": "rds",
    "type": "data"
   },
   {
    "id": "c9",
    "source": "worker",
    "target": "s3",
    "type": "data"
   },
   {
    "id": "c10",
    "source": "worker",
    "target": "nat",
    "type": "network"
   },
   {
    "id": "c11",
    "source": "nat",
    "target": "dx",
    "type": "network"
   },
   {
    "id": "c12",
    "source": "dx",
    "target": "argo",
    "label": "HTTPS 443 read-only",
    "type": "network"
   },
   {
    "id": "c13",
    "source": "argo",
    "target": "k8s",
    "label": "sync"
   }
  ]
 }
}